{
  "manifest_version": 3,
  "name": "Quiz Solver Ai",
  "version": "1.0",
  "description": "Ekstensi untuk menjawab quiz berbentuk pilihan ganda",
  "permissions": [
    "storage"
  ],
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>", "file:///*"],
      "js": ["content.js"]
    }
  ]
}